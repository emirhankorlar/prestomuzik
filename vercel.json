{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/spotify.js": { "maxDuration": 60 },
    "api/upload.js": { "maxDuration": 30 }
